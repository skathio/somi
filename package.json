{
  "name": "@skathio/somi",
  "version": "5.0.1",
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "bench": "node benchmarks/v2/bench.mjs",
    "mutate": "node tests/mutate.mjs"
  },
  "bin": {
    "somi": "scripts/somi.mjs"
  },
  "description": "A workflow plugin for coding agents: say what you want or pass a ticket, and it picks the right workflow and keeps the cost down, while your agent stays in charge.",
  "keywords": [
    "workflow",
    "code-review",
    "security",
    "sandbox",
    "claude-code",
    "copilot"
  ],
  "author": {
    "name": "SoMi contributors",
    "url": "https://github.com/skathio/somi"
  },
  "license": "MIT",
  "homepage": "https://github.com/skathio/somi",
  "repository": {
    "type": "git",
    "url": "https://github.com/skathio/somi.git"
  },
  "bugs": {
    "url": "https://github.com/skathio/somi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agents/",
    "commands/",
    "skills/",
    "rules/",
    "hooks/",
    "profiles/",
    "scripts/",
    ".claude-plugin/",
    ".copilot-extension/",
    "mcp.json",
    "VERSION",
    "LICENSE",
    "library/",
    "workflows/"
  ]
}
