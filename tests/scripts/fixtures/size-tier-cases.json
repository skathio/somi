    { "name": "H4 corpus: file serving from a shared folder, path handling unprompted", "set": { "T1": false, "T2": false, "T3": false, "hard_surface": true, "est_files": 3, "est_diff_lines": 180 }, "expect": { "tier": "full", "reasons": ["hard_surface"], "securityLens": true } },
