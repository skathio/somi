{
  "base": { "T1": true, "T2": true, "T3": true, "T4": true, "T5": true, "sensitive_core": false, "hard_surface": false, "design_open": false, "open_questions": 0, "acceptance_testable": true, "modules_touched": 1, "est_files": 1, "est_diff_lines": 40, "existing_work_item": false, "brief_exists": false },
  "comment": "set: id -> value (evidence added) or {entry: raw}; drop: ids removed; noEvidence: ids without evidence; raw: whole input. expect: tier, floor (absent = null), unknown, invalid (failed is their union), reasons, basis (the ids present in the basis map, optional). Corpus rows are the seven A/B tickets mapped by hand under the rubric's rulings; count signals are production code only, tests excluded.",
  "cases": [
    { "name": "all clear, one file", "expect": { "tier": "trivial", "reasons": [], "basis": ["T1", "T2", "T3", "T4", "T5", "sensitive_core", "hard_surface", "design_open", "open_questions", "acceptance_testable", "modules_touched", "est_files", "est_diff_lines", "existing_work_item", "brief_exists"] } },
    { "name": "T1 corpus: new two-function module, greenfield", "set": { "T2": false, "est_diff_lines": 80 }, "expect": { "tier": "small", "reasons": ["T2", "est_diff_lines"] } },
